---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-lavanderia.json';

const produtos = dados.zonas.flatMap((zona) => zona.produtos);

const faixas = [
  {
    id: 'ate-50',
    titulo: 'Até R$ 50',
    texto: 'A faixa mais barata: cesto multiuso e varal, resolve rápido.',
    produtos: produtos.filter((p) => p.precoMin < 50),
  },
  {
    id: '50-a-100',
    titulo: 'De R$ 50 a R$ 100',
    texto: 'Faixa intermediária: varal com base antiderrapante, prateleira com rodízio.',
    produtos: produtos.filter((p) => p.precoMin >= 50 && p.precoMin < 100),
  },
  {
    id: 'acima-100',
    titulo: 'Acima de R$ 100',
    texto: 'O investimento mais alto da lista: mais capacidade e estrutura.',
    produtos: produtos.filter((p) => p.precoMin >= 100),
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://casapratica.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Organização de lavanderia", item: "https://casapratica.dicasinteligentes.com/organizacao-lavanderia/" },
    { "@type": "ListItem", position: 3, name: "Por orçamento", item: "https://casapratica.dicasinteligentes.com/organizacao-lavanderia/por-orcamento/" },
  ],
};
---
<Layout
  title="Organização de lavanderia por orçamento"
  description="Cesto de roupa, varal e produtos de limpeza separados por faixa de preço, do mais barato ao mais completo, pra decidir por onde começar."
>
  <p><a href="/organizacao-lavanderia/">← Organização de lavanderia</a></p>
  <h1>Organização de lavanderia por orçamento</h1>
  <p class="atualizado">Atualizado em setembro de 2026</p>

  <p>
    Os mesmos produtos do guia principal, separados por faixa de preço,
    pra você decidir por onde começar de acordo com o que tem disponível
    pra gastar agora.
  </p>

  <section class="raciocinio">
    <h2>O que muda de verdade entre as faixas</h2>
    <p>
      Até R$50 as duas opções abrem mão de algo: o cesto sem tampa deixa a
      roupa suja visível, e o organizador de tanque ainda tem poucas
      avaliações por ser mais novo no mercado. Na faixa de R$50 a R$100
      estão o cesto de bambu (estrutura rígida, ocupa espaço fixo, não dá
      pra guardar achatado quando vazio), o varal mais vendido (nota um
      pouco menor que a opção Powermaid da mesma faixa) e a prateleira de
      plástico (mais leve e barata, mas menos durável a longo prazo que
      uma estrutura de metal).
    </p>
  </section>

  {faixas.filter((faixa) => faixa.produtos.length > 0).map((faixa) => (
    <section id={faixa.id} class="faixa">
      <h2>{faixa.titulo}</h2>
      <p>{faixa.texto}</p>
      {faixa.produtos.map((produto) => <ProdutoCard produto={produto} />)}
    </section>
  ))}

  <p class="cta-final">
    Quer ver a lista completa, com comparativo rápido?
    <a href="/organizacao-lavanderia/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .faixa { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
