---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-quarto.json';

const produtos = dados.zonas.flatMap((zona) => zona.produtos);

const faixas = [
  {
    id: 'ate-50',
    titulo: 'Até R$ 50',
    texto: 'A faixa mais barata: colmeia pra gaveta e mancebo pra casaco e bolsa.',
    produtos: produtos.filter((p) => p.precoMin < 50),
  },
  {
    id: '50-a-200',
    titulo: 'De R$ 50 a R$ 200',
    texto: 'Faixa intermediária: o kit de colmeias e a mesa de cabeceira mais barata.',
    produtos: produtos.filter((p) => p.precoMin >= 50 && p.precoMin < 200),
  },
  {
    id: 'acima-200',
    titulo: 'Acima de R$ 200',
    texto: 'O investimento mais alto da lista: cabideiro de trilho duplo e a mesa de cabeceira mais firme.',
    produtos: produtos.filter((p) => p.precoMin >= 200),
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://casapratica.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Organização de quarto", item: "https://casapratica.dicasinteligentes.com/organizacao-quarto/" },
    { "@type": "ListItem", position: 3, name: "Por orçamento", item: "https://casapratica.dicasinteligentes.com/organizacao-quarto/por-orcamento/" },
  ],
};
---
<Layout
  title="Organização de quarto por orçamento"
  description="Colmeia, mesa de cabeceira e cabideiro separados por faixa de preço, do mais barato ao mais completo, pra decidir por onde começar."
>
  <p><a href="/organizacao-quarto/">← Organização de quarto</a></p>
  <h1>Organização de quarto por orçamento</h1>
  <p class="atualizado">Atualizado em setembro de 2026</p>

  <p>
    Os mesmos produtos do guia principal, separados por faixa de preço,
    pra você decidir por onde começar de acordo com o que tem disponível
    pra gastar agora.
  </p>

  <section class="raciocinio">
    <h2>O que muda de verdade entre as faixas</h2>
    <p>
      Até R$50 os dois produtos resolvem coisas diferentes: a colmeia
      Ordene organiza a gaveta de roupa íntima (R$26, com divisórias
      que podem amassar) e o mancebo Kontuz dá lugar pra casaco e bolsa
      (R$47 a R$55, a menor nota da lista, com queixas de montagem). Na
      faixa de R$50 a R$200, o kit Organizaplus (R$79 a R$83) cobre a
      gaveta toda com 12 peças, e a mesa Artely (R$116 a R$141) resolve
      a cabeceira, mas aguenta só 4 kg. Acima de R$200 estão o cabideiro
      SONGMICS (R$288 a R$360), o único com trilho duplo, que suporta 90
      kg, e a mesa Leomonio (R$330), que sustenta 13,6 kg mas custa mais
      que o dobro da Artely.
    </p>
  </section>

  {faixas.filter((faixa) => faixa.produtos.length > 0).map((faixa) => (
    <section id={faixa.id} class="faixa">
      <h2>{faixa.titulo}</h2>
      <p>{faixa.texto}</p>
      {faixa.produtos.map((produto) => <ProdutoCard produto={produto} />)}
    </section>
  ))}

  <p class="cta-final">
    Quer ver a lista completa, com comparativo rápido?
    <a href="/organizacao-quarto/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .faixa { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
