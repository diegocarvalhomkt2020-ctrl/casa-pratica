---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-sala.json';

const produtos = dados.zonas.flatMap((zona) => zona.produtos);

const faixas = [
  {
    id: 'ate-50',
    titulo: 'Até R$ 50',
    texto: 'A faixa mais barata: organizador de cabos, resolve rápido e sem gastar muito.',
    produtos: produtos.filter((p) => p.precoMin < 50),
  },
  {
    id: '50-a-200',
    titulo: 'De R$ 50 a R$ 200',
    texto: 'Faixa intermediária: sapateiras com mais capacidade.',
    produtos: produtos.filter((p) => p.precoMin >= 50 && p.precoMin < 200),
  },
  {
    id: 'acima-200',
    titulo: 'Acima de R$ 200',
    texto: 'O investimento mais alto da lista: estantes de livros, mais estrutura e capacidade.',
    produtos: produtos.filter((p) => p.precoMin >= 200),
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://casapratica.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Organização de sala de estar", item: "https://casapratica.dicasinteligentes.com/organizacao-sala/" },
    { "@type": "ListItem", position: 3, name: "Por orçamento", item: "https://casapratica.dicasinteligentes.com/organizacao-sala/por-orcamento/" },
  ],
};
---
<Layout
  title="Organização de sala de estar por orçamento"
  description="Estante, sapateira e organizador de cabos separados por faixa de preço, do mais barato ao mais completo, pra decidir por onde começar."
>
  <p><a href="/organizacao-sala/">← Organização de sala de estar</a></p>
  <h1>Organização de sala de estar por orçamento</h1>
  <p class="atualizado">Atualizado em setembro de 2026</p>

  <p>
    Os mesmos produtos do guia principal, separados por faixa de preço,
    pra você decidir por onde começar de acordo com o que tem disponível
    pra gastar agora.
  </p>

  <section class="raciocinio">
    <h2>O que muda de verdade entre as faixas</h2>
    <p>
      Até R$50 os dois organizadores de cabo resolvem de formas diferentes:
      a Sfor é uma mangueira única de 1,5m (pra rack grande, pode precisar
      de mais de uma), a Abcfixadores prende cabo por cabo individualmente
      (mais trabalhosa de instalar se forem muitos fios). Na faixa de R$50
      a R$200 estão as sapateiras: a mais barata tem a nota mais baixa da
      lista inteira apesar do volume alto de vendas, a de maior capacidade
      ainda tem poucas avaliações acumuladas. Acima de R$200 são as
      estantes, e aqui o cuidado muda de categoria: a de 6 níveis é alta e
      estreita, sem fixar na parede o risco de tombar aumenta com
      prateleira muito carregada.
    </p>
  </section>

  {faixas.filter((faixa) => faixa.produtos.length > 0).map((faixa) => (
    <section id={faixa.id} class="faixa">
      <h2>{faixa.titulo}</h2>
      <p>{faixa.texto}</p>
      {faixa.produtos.map((produto) => <ProdutoCard produto={produto} />)}
    </section>
  ))}

  <p class="cta-final">
    Quer ver a lista completa, com comparativo rápido?
    <a href="/organizacao-sala/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .faixa { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
