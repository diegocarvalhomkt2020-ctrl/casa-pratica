---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos.json';

const zonas = dados.zonas;

const todosProdutos = zonas.flatMap((zona) =>
  zona.produtos.map((produto) => ({ ...produto, zonaNome: zona.nome, zonaId: zona.id }))
);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://casapratica.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Organização de cozinha", item: "https://casapratica.dicasinteligentes.com/organizacao-cozinha/" },
  ],
};

const faq = [
  {
    pergunta: "Por onde eu começo a organizar a cozinha?",
    resposta: "[substituir: resposta real, provavelmente indicando a zona que mais incomoda ou a mais rápida de resolver primeiro]",
  },
  {
    pergunta: "Preciso comprar tudo de uma vez?",
    resposta: "[substituir: resposta real, reforçando que dá pra fazer zona por zona, sem gastar tudo de uma vez]",
  },
  {
    pergunta: "Pote de plástico ou de vidro, qual vale mais a pena?",
    resposta: "[substituir: resposta real com base nos produtos escolhidos pra cada zona]",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.resposta,
    },
  })),
};
---
<Layout
  title="Organização de cozinha, zona por zona"
  description="Organize a cozinha por zona, com tempo e faixa de preço estimados pra cada uma."
>
  <p><a href="/">← Início</a></p>
  <h1>Organização de cozinha, zona por zona</h1>
  <p class="atualizado">Atualizado em agosto de 2026</p>

  <p class="atualizado">
    Todos os produtos abaixo foram pesquisados na Amazon, com preço, nota e
    avaliações reais. Fotos ainda em produção.
  </p>

  <p>
    Organizar a cozinha inteira leva algumas horas, divididas em zonas
    pequenas. Não precisa fazer tudo no mesmo dia. Comece pela zona que
    mais incomoda.
  </p>

  <section class="como-escolhemos">
    <h2>Como escolhemos</h2>
    <p>
      Nenhum produto entra nessa lista sem um contra declarado (bloco
      "Vale saber" em cada card). Preço sempre em faixa, nunca fixo: faixa
      de preço muda com o tempo, valor fixo não. "Ainda sem avaliações
      suficientes" significa que o produto está em análise, não que já foi
      validado por compra real.
    </p>
  </section>

  <section class="comparativo">
    <h2>Comparativo rápido</h2>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th>Produto</th>
            <th>Zona</th>
            <th>Preço</th>
            <th>Selo</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {todosProdutos.map((produto) => (
            <tr>
              <td data-label="Produto">{produto.nome}</td>
              <td data-label="Zona">{produto.zonaNome}</td>
              <td data-label="Preço">R$ {produto.precoMin} a R$ {produto.precoMax}</td>
              <td data-label="Selo">{produto.selo || "—"}</td>
              <td data-label="">
                {produto.linkAmazon && produto.linkAmazon !== "#" ? (
                  <a class="botao-tabela" href={produto.linkAmazon} rel="sponsored nofollow">Ver preço</a>
                ) : (
                  <a class="botao-tabela botao-tabela-secundario" href={`#${produto.zonaId}`}>Ver detalhes</a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <nav class="zonas-nav">
    {zonas.map((zona) => (
      <a href={`#${zona.id}`} class="pill">{zona.nome}</a>
    ))}
  </nav>

  {zonas.map((zona) => (
    <section id={zona.id} class="zona">
      <h2>{zona.nome}</h2>
      <p class="tempo">Tempo estimado: {zona.tempoEstimado}</p>
      <p>{zona.descricao}</p>
      {zona.produtos.map((produto) => <ProdutoCard produto={produto} />)}
    </section>
  ))}

  <p class="cluster-link">
    <a href="/organizacao-cozinha/erros-comuns/">Veja também: os erros mais comuns ao organizar a cozinha →</a>
  </p>

  <section class="honestidade">
    <h2>Onde vale gastar mais, onde não faz diferença</h2>
    <p>
      [substituir: 2-3 frases resumindo, com base nos produtos reais escolhidos,
      em quais zonas compensa investir em um item de qualidade e em quais um
      produto mais barato resolve igual.]
    </p>
  </section>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <div class="faq-item">
        <h3>{item.pergunta}</h3>
        <p>{item.resposta}</p>
      </div>
    ))}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .cluster-link { font-weight: 600; margin: 2.5rem 0 0; }
    .como-escolhemos {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .como-escolhemos h2 { font-size: 1rem; margin: 0 0 0.4rem; }
    .como-escolhemos p { margin: 0; font-size: 0.9rem; color: var(--cor-texto-suave); }
    .comparativo { margin: 1.5rem 0 2.5rem; }
    .tabela-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--cor-borda);
      white-space: normal;
      overflow-wrap: break-word;
    }
    th { color: var(--cor-texto-suave); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    th:nth-child(1), td:nth-child(1) { width: 29%; }
    th:nth-child(2), td:nth-child(2) { width: 12%; }
    th:nth-child(3), td:nth-child(3) { width: 18%; }
    th:nth-child(4), td:nth-child(4) { width: 20%; }
    th:nth-child(5), td:nth-child(5) { width: 21%; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      font-size: 0.76rem;
      white-space: normal;
    }
    .botao-tabela-secundario { background: var(--cor-texto-suave); }

    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { position: absolute; left: -9999px; }
      tr {
        border: 1px solid var(--cor-borda);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.75rem;
        background: var(--cor-superficie);
      }
      td {
        border: none;
        padding: 0.35rem 0;
        white-space: normal;
      }
      td[data-label]:not([data-label=""])::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--cor-texto-suave);
        margin-bottom: 0.1rem;
      }
      td:last-child { padding-top: 0.6rem; }
    }
    .zonas-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 1.5rem 0 2.5rem;
    }
    .pill {
      border: 1px solid var(--cor-borda);
      border-radius: 999px;
      padding: 0.4rem 0.9rem;
      font-size: 0.85rem;
      text-decoration: none;
      color: var(--cor-texto);
    }
    .zona { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .tempo {
      display: inline-block;
      font-size: 0.82rem;
      color: var(--cor-acento);
      font-weight: 600;
      margin: 0 0 0.75rem;
    }
    .honestidade, .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }
  </style>
</Layout>
