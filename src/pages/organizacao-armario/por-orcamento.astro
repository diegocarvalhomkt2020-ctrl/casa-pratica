---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-armario.json';

const produtos = dados.zonas.flatMap((zona) => zona.produtos);

const faixas = [
  {
    id: 'ate-50',
    titulo: 'Até R$ 50',
    texto: 'A faixa mais barata: cabides simples, resolve rápido sem gastar muito.',
    produtos: produtos.filter((p) => p.precoMin < 50),
  },
  {
    id: '50-a-120',
    titulo: 'De R$ 50 a R$ 120',
    texto: 'Faixa intermediária: caixas organizadoras e sapateiras com mais capacidade.',
    produtos: produtos.filter((p) => p.precoMin >= 50 && p.precoMin < 120),
  },
  {
    id: 'acima-120',
    titulo: 'Acima de R$ 120',
    texto: 'O investimento mais alto da lista: mais capacidade e estrutura.',
    produtos: produtos.filter((p) => p.precoMin >= 120),
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://casapratica.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Organização de armário", item: "https://casapratica.dicasinteligentes.com/organizacao-armario/" },
    { "@type": "ListItem", position: 3, name: "Por orçamento", item: "https://casapratica.dicasinteligentes.com/organizacao-armario/por-orcamento/" },
  ],
};
---
<Layout
  title="Organização de armário por orçamento"
  description="Cabide, caixa organizadora e sapateira separados por faixa de preço, do mais barato ao mais completo."
>
  <p><a href="/organizacao-armario/">← Organização de armário</a></p>
  <h1>Organização de armário por orçamento</h1>
  <p class="atualizado">Atualizado em setembro de 2026</p>

  <p>
    Os mesmos produtos do guia principal, separados por faixa de preço,
    pra você decidir por onde começar de acordo com o que tem disponível
    pra gastar agora.
  </p>

  <section class="raciocinio">
    <h2>O que muda de verdade entre as faixas</h2>
    <p>
      Até R$50 você resolve rápido, mas com concessão: o cabide multiuso
      mais barato tem nota e volume de avaliações bem menores que os
      outros da lista, e a bolsa organizadora com zíper é de tecido macio,
      não empilha peso alto sem amassar o que está dentro. Na faixa de R$50
      a R$120 já entram peças mais robustas, como o cabide de madeira (só
      que vendido em kit de 10, pode precisar de mais de um) e a caixa
      opaca de 56 litros (sem visor, precisa etiquetar pra lembrar o que
      guardou). Acima de R$120 é onde entra a maior capacidade de verdade,
      mas com ressalvas específicas: o cabide de veludo aguenta só 2,5kg
      por clipe e não pode ir na secadora, e as sapateiras maiores exigem
      medir o espaço antes de comprar.
    </p>
  </section>

  {faixas.filter((faixa) => faixa.produtos.length > 0).map((faixa) => (
    <section id={faixa.id} class="faixa">
      <h2>{faixa.titulo}</h2>
      <p>{faixa.texto}</p>
      {faixa.produtos.map((produto) => <ProdutoCard produto={produto} />)}
    </section>
  ))}

  <p class="cta-final">
    Quer ver a lista completa, com comparativo rápido?
    <a href="/organizacao-armario/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .faixa { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
