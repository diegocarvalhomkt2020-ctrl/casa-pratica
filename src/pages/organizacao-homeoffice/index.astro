---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-homeoffice.json';

const zonas = dados.zonas;

const todosProdutos = zonas.flatMap((zona) =>
  zona.produtos.map((produto) => ({ ...produto, zonaNome: zona.nome, zonaId: zona.id }))
);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://casapratica.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Organização de home office", item: "https://casapratica.dicasinteligentes.com/organizacao-homeoffice/" },
  ],
};

const faq = [
  {
    pergunta: "Suporte de notebook substitui monitor externo?",
    resposta: "Não resolve o mesmo problema. O suporte ajuda a postura (eleva a tela na altura dos olhos), mas se você usa o teclado do próprio notebook depois de elevado, vai precisar de teclado e mouse externos pra não forçar os pulsos. Monitor externo é sobre ter mais espaço de tela, não sobre postura.",
  },
  {
    pergunta: "Luminária de mesa realmente faz diferença ou é só estética?",
    resposta: "Faz diferença real em jornada de tela longa — luz de teto genérica cria reflexo e sombra irregular na mesa, luminária dedicada permite ajustar posição e intensidade pro seu ângulo de trabalho específico.",
  },
  {
    pergunta: "Vale a pena um organizador de mesa com gaveta em vez do modelo fixo?",
    resposta: "Vale se você tem itens pequenos que prefere não deixar à vista (chaves, carregador, post-it). Se o objetivo é só organizar caneta e papel visíveis, o modelo fixo (mais barato) já resolve.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta },
  })),
};
---
<Layout
  title="Organização de home office: mesa, notebook e luminária"
  description="Organizador de mesa, suporte de notebook e luminária pesquisados na Amazon, com preço, nota e o defeito real de cada um."
>
  <p><a href="/">← Início</a></p>
  <h1>Organização de home office: mesa, notebook e luminária</h1>
  <p class="atualizado">Atualizado em setembro de 2026</p>

  <p class="atualizado">
    Todos os produtos abaixo foram pesquisados na Amazon, com preço, nota e
    avaliações reais.
  </p>

  <p>
    Mesa bagunçada, notebook direto na mesa forçando o pescoço e luz ruim
    pra videochamada são os três problemas que mais atrapalham quem
    trabalha de casa. Cada zona abaixo resolve um desses de forma
    separada.
  </p>

  <section class="como-escolhemos">
    <h2>Como escolhemos</h2>
    <p>
      Nenhum produto entra nessa lista sem um contra declarado (bloco "Vale
      saber" em cada card), tirado da ficha técnica e das características
      reais do produto. Preço sempre em faixa, nunca fixo.
    </p>
  </section>

  <section class="comparativo">
    <h2>Comparativo rápido</h2>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Produto</th>
            <th scope="col">Zona</th>
            <th scope="col">Preço</th>
            <th scope="col">Selo</th>
            <th scope="col"><span class="sr-only">Link</span></th>
          </tr>
        </thead>
        <tbody>
          {todosProdutos.map((produto) => (
            <tr>
              <td data-label="Produto">{produto.nome}</td>
              <td data-label="Zona">{produto.zonaNome}</td>
              <td data-label="Preço">{produto.precoMin === produto.precoMax ? `R$ ${produto.precoMin}` : `R$ ${produto.precoMin} a R$ ${produto.precoMax}`}</td>
              <td data-label="Selo">{produto.selo || "—"}</td>
              <td data-label="">
                <a class="botao-tabela" href={produto.linkAmazon} rel="sponsored nofollow">Ver preço</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="honestidade">
    <h2>Onde vale gastar mais, onde não faz diferença</h2>
    <p>
      No organizador de mesa, a diferença entre os dois modelos é sobre ter
      gaveta ou não, não sobre qualidade — escolha pelo que você precisa
      guardar. No suporte de notebook, os dois custam quase o mesmo, mas o
      ELG tem mais níveis de ajuste fino; vale a pena se sua altura de
      trabalho ideal for específica. Na luminária, o salto de R$99 pra
      R$170 compra controle remoto, timer e mais cores de luz — só
      compensa se você realmente vai usar esses recursos extras.
    </p>
  </section>

  <nav class="zonas-nav">
    {zonas.map((zona) => (
      <a href={`#${zona.id}`} class="pill">{zona.nome}</a>
    ))}
  </nav>

  {zonas.map((zona) => (
    <section id={zona.id} class="zona">
      <h2>{zona.nome}</h2>
      <p class="tempo">Tempo estimado: {zona.tempoEstimado}</p>
      <p>{zona.descricao}</p>
      {zona.produtos.map((produto) => <ProdutoCard produto={produto} />)}
    </section>
  ))}

  <p class="cluster-link">
    Veja também:
    <a href="/organizacao-homeoffice/erros-comuns/">os erros mais comuns organizando o home office →</a>
    ·
    <a href="/organizacao-homeoffice/por-orcamento/">os mesmos produtos por orçamento →</a>
    ·
    <a href="/organizacao-homeoffice/comparativo-top3/">comparativo Top 3 lado a lado →</a>
    ·
    <a href="/organizacao-sala/">organização de sala de estar →</a>
    ·
    <a href="/organizacao-armario/">organização de armário, zona por zona →</a>
    ·
    <a href="/organizacao-lavanderia/">organização de lavanderia →</a>
  </p>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <div class="faq-item">
        <h3>{item.pergunta}</h3>
        <p>{item.resposta}</p>
      </div>
    ))}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .cluster-link { font-weight: 600; margin: 2.5rem 0 0; line-height: 2; }
    .como-escolhemos {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .como-escolhemos h2 { font-size: 1rem; margin: 0 0 0.4rem; }
    .como-escolhemos p { margin: 0; font-size: 0.9rem; color: var(--cor-texto-suave); }
    .comparativo { margin: 1.5rem 0 2.5rem; }
    .tabela-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--cor-borda);
      white-space: normal;
      overflow-wrap: break-word;
    }
    th { color: var(--cor-texto-suave); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    th:nth-child(1), td:nth-child(1) { width: 34%; }
    th:nth-child(2), td:nth-child(2) { width: 18%; }
    th:nth-child(3), td:nth-child(3) { width: 18%; }
    th:nth-child(4), td:nth-child(4) { width: 16%; }
    th:nth-child(5), td:nth-child(5) { width: 14%; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      font-size: 0.76rem;
      white-space: nowrap;
    }
    .categoria { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .honestidade {
      margin: 2.5rem 0;
      padding: 1.5rem 1.75rem;
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-left: 4px solid var(--cor-vale-saber);
      border-radius: 10px;
    }
    .honestidade h2 { margin: 0 0 0.75rem; font-size: 1.15rem; }
    .honestidade p { margin: 0; color: var(--cor-texto-suave); }
    .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }

    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { position: absolute; left: -9999px; }
      tr {
        border: 1px solid var(--cor-borda);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.75rem;
        background: var(--cor-superficie);
      }
      td {
        border: none;
        padding: 0.35rem 0;
        white-space: normal;
        width: auto !important;
      }
      td[data-label="Preço"] { white-space: nowrap; }
      td[data-label]:not([data-label=""])::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--cor-texto-suave);
        margin-bottom: 0.1rem;
      }
      td:last-child { padding-top: 0.6rem; }
    }
    .zonas-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 1.5rem 0 2.5rem;
    }
    .pill {
      border: 1px solid var(--cor-borda);
      border-radius: 999px;
      padding: 0.4rem 0.9rem;
      font-size: 0.85rem;
      text-decoration: none;
      color: var(--cor-texto);
    }
    .zona { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .tempo {
      display: inline-block;
      font-size: 0.82rem;
      color: var(--cor-acento);
      font-weight: 600;
      margin: 0 0 0.75rem;
    }
  </style>
</Layout>
