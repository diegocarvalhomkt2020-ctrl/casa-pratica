---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-homeoffice.json';

const produtos = dados.zonas.flatMap((zona) => zona.produtos);

const faixas = [
  {
    id: 'ate-50',
    titulo: 'Até R$ 50',
    texto: 'A faixa mais barata: organizador de mesa e suporte de notebook simples.',
    produtos: produtos.filter((p) => p.precoMin < 50),
  },
  {
    id: '50-a-150',
    titulo: 'De R$ 50 a R$ 150',
    texto: 'Faixa intermediária: suporte com mais ajuste, luminária mais simples.',
    produtos: produtos.filter((p) => p.precoMin >= 50 && p.precoMin < 150),
  },
  {
    id: 'acima-150',
    titulo: 'Acima de R$ 150',
    texto: 'O investimento mais alto da lista: luminária com mais recursos.',
    produtos: produtos.filter((p) => p.precoMin >= 150),
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://casapratica.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Organização de home office", item: "https://casapratica.dicasinteligentes.com/organizacao-homeoffice/" },
    { "@type": "ListItem", position: 3, name: "Por orçamento", item: "https://casapratica.dicasinteligentes.com/organizacao-homeoffice/por-orcamento/" },
  ],
};
---
<Layout
  title="Organização de home office por orçamento"
  description="Organizador de mesa, suporte de notebook e luminária separados por faixa de preço, do mais barato ao mais completo."
>
  <p><a href="/organizacao-homeoffice/">← Organização de home office</a></p>
  <h1>Organização de home office por orçamento</h1>
  <p class="atualizado">Atualizado em setembro de 2026</p>

  <p>
    Os mesmos produtos do guia principal, separados por faixa de preço,
    pra você decidir por onde começar de acordo com o que tem disponível
    pra gastar agora.
  </p>

  <section class="raciocinio">
    <h2>O que muda de verdade entre as faixas</h2>
    <p>
      Até R$50 cabem os dois organizadores de mesa e os dois suportes de
      notebook: o Acrimet é peça fixa, não modular, o com gaveta tem nota
      levemente mais baixa; o suporte de alumínio é simples, sem os 10
      níveis de regulagem fina do ELG, cujo preço máximo anunciado é quase
      o dobro do mínimo, vale conferir o valor final antes de decidir. Na
      faixa de R$50 a R$150 está a luminária mais barata, com volume de
      avaliações ainda pequeno e a nota mais baixa entre as duas opções.
      Acima de R$150, a Tobeape custa quase o dobro da mais barata e
      também ainda tem poucas avaliações acumuladas, mesmo com nota mais
      alta.
    </p>
  </section>

  {faixas.filter((faixa) => faixa.produtos.length > 0).map((faixa) => (
    <section id={faixa.id} class="faixa">
      <h2>{faixa.titulo}</h2>
      <p>{faixa.texto}</p>
      {faixa.produtos.map((produto) => <ProdutoCard produto={produto} />)}
    </section>
  ))}

  <p class="cta-final">
    Quer ver a lista completa, com comparativo rápido?
    <a href="/organizacao-homeoffice/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .faixa { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
