---
import Layout from '../layouts/Layout.astro';
import leadmagnet from '../data/leadmagnet.json';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://casapratica.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Guia grátis", item: "https://casapratica.dicasinteligentes.com/guia-gratis/" },
  ],
};
---
<Layout
  title={leadmagnet.titulo}
  description={leadmagnet.descricao}
>
  <p><a href="/">← Início</a></p>
  <h1>{leadmagnet.titulo}</h1>
  <p class="intro">{leadmagnet.descricao}</p>

  {!leadmagnet.capturaAtiva && (
    <div class="bloco-download">
      <p class="selo">GUIA GRATUITO · PDF</p>
      <p>
        Sem cadastro por enquanto: baixe direto pelo botão abaixo.
      </p>
      <a class="botao-baixar" href={leadmagnet.arquivoPdf} download>
        Baixar o guia em PDF →
      </a>
    </div>
  )}

  {leadmagnet.capturaAtiva && leadmagnet.formEmbedId && (
    <div class="bloco-form">
      <p class="selo">GUIA GRATUITO · PDF</p>
      <iframe
        src={`https://reach-forms.hostingerusercontent.com/form/${leadmagnet.formEmbedId}`}
        title="Formulário de inscrição"
        loading="lazy"
      />
    </div>
  )}

  <p class="cta-final">
    Quer ver os cômodos completos? <a href="/">Volte pro início →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .intro { color: var(--cor-texto-suave); max-width: 560px; margin: 1rem 0 2rem; }
    .selo {
      display: inline-block;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.72rem;
      font-weight: 800;
      color: var(--cor-acento);
      margin: 0 0 0.6rem;
    }
    .bloco-download, .bloco-form {
      border: 1px solid var(--cor-borda);
      border-radius: 16px;
      padding: 1.5rem 1.75rem;
      background: var(--cor-superficie);
      max-width: 480px;
      margin: 1.5rem 0 2rem;
    }
    .botao-baixar {
      display: inline-block;
      margin-top: 0.75rem;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.7rem 1.3rem;
      border-radius: 999px;
      font-weight: 700;
    }
    .bloco-form iframe {
      width: 100%;
      min-height: 380px;
      border: none;
    }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
